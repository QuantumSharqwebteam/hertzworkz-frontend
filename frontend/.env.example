# Copy to .env.local and fill in once the backend exists.
# Base URL (or full path) the Contact form POSTs submissions to.
VITE_CONTACT_API_URL=/api/contact
# Base URL (or full path) the footer newsletter box POSTs subscriptions to.
VITE_NEWSLETTER_API_URL=/api/newsletter/subscribe
# Base URL (or full path) the Careers page fetches job listings from.
VITE_JOBS_API_URL=/api/jobs
# Base URL of the real recruitment API the Careers page now reads openings
# from and submits applications to (replaces VITE_JOBS_API_URL above).
VITE_CAREERS_API_BASE_URL=https://ecg4jls448.execute-api.us-east-1.amazonaws.com
