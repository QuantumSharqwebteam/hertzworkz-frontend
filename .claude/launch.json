{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "preview"],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/node_modules/serverless/run.js", "offline", "--config", "backend/serverless.yml"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend-attach",
      "url": "http://localhost:3000"
    }
  ]
}
